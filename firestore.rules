rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // All collections are locked for browser access.
    // All reads/writes go through server-side Admin SDK in API routes.

    match /leads/{leadId} {
      allow read, write: if false;
    }

    match /newsletter_subscribers/{subscriberId} {
      allow read, write: if false;
    }

    match /admins/{uid} {
      allow read, write: if false;
    }

    match /email_templates/{templateId} {
      allow read, write: if false;
    }

    match /blogs/{blogId} {
      allow read, write: if false;
    }

    match /email_daily_limits/{docId} {
      allow read, write: if false;
    }

    match /email_messages/{docId} {
      allow read, write: if false;
    }

    // site_settings: used for pricing config — Admin SDK only, no browser access
    match /site_settings/{docId} {
      allow read, write: if false;
    }
  }
}