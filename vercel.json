{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ],
  "redirects": [
    { "source": "/:path*", "destination": "https://walktopus.in/:path*", "permanent": true, "has": [{ "type": "host", "value": "www.walktopus.in" }] },
    { "source": "/home", "destination": "/", "permanent": true },
    { "source": "/services/social-media", "destination": "/services#social-media", "permanent": false },
    { "source": "/:path((?!_next).*)\/", "destination": "/:path", "permanent": true }
  ]
}
